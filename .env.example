# Salin jadi .env: cp .env.example .env
# Generate secret: openssl rand -base64 48
NODE_ENV=production
PORT=3000

# WAJIB stabil. Kalau berubah, semua konfigurasi provider (bot token Telegram, password
# Mega, service account Google) yang tersimpan terenkripsi di SQLite tidak bisa didekripsi
# lagi. Nilai yang sama juga dipakai update-code.sh saat menyuntik ecosystem.config.cjs.
STORAGE_CONFIG_KEY=ganti-dengan-secret-acak-minimal-32-karakter

# Batas ukuran satu file, dalam byte. 5368709120 = 5 GB.
# Catatan: Telegram Bot API hanya menerima file sampai 50 MB (52428800 byte).
MAX_FILE_SIZE=5368709120

# Masa simpan item di Sampah sebelum dibersihkan otomatis, dalam hari. Default 30.
TRASH_RETENTION_DAYS=30

# Batas diamnya soket (ms) saat mengirim berkas ke provider. Kalau provider sudah menerima
# seluruh berkas lalu berhenti menjawab, permintaan dijawab 502 dan dicatat di log, bukan
# menggantung sampai Cloudflare memutusnya di 100 detik (524) tanpa baris database.
# Default 95000: jawaban Telegram tumbuh seiring ukuran berkas (3 MB +-35 detik, 5 MB +-60 detik),
# jadi batas 60 detik membuang unggahan yang sebenarnya berhasil dan meninggalkan berkas yatim di
# channel. Harus tetap di bawah batas 100 detik Cloudflare supaya klien menerima pesan galat jelas.
UPLOAD_IDLE_TIMEOUT_MS=95000

# Opsional: chat/owner ID Telegram default kalau provider tidak mengisi chatId.
# TELEGRAM_CHAT_ID=-1001234567890
